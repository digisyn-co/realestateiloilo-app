# =========================================================================
# Real Estate Iloilo — environment configuration
# Copy to `.env` and fill in. Never commit real secrets.
# =========================================================================

# --- Core -----------------------------------------------------------------
# App base URL (used for absolute links, share URLs, OAuth callbacks)
APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Database -------------------------------------------------------------
# Production + Vercel use Postgres (the schema's datasource provider is
# "postgresql"). Use a pooled connection string on serverless (Neon/Supabase/
# Vercel Postgres provide one). PostGIS is recommended for geospatial search.
# Runtime (pooled — Supabase transaction pooler, port 6543):
DATABASE_URL="postgresql://postgres.REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migrations / seeding (direct — port 5432). Prisma CLI only. If you only have
# one string, set this to the same value as DATABASE_URL.
DIRECT_URL="postgresql://postgres:PASSWORD@db.REF.supabase.co:5432/postgres?sslmode=require"
# For zero-setup LOCAL dev you can instead set provider="sqlite" in
# prisma/schema.prisma and use DATABASE_URL="file:./dev.db" (DIRECT_URL unused).

# --- Authentication -------------------------------------------------------
# 32+ char secret used to sign session JWTs (generate: openssl rand -base64 32)
AUTH_SECRET="dev-only-insecure-secret-change-me-please-32chars"
SESSION_COOKIE_NAME="rei_session"
# Optional OAuth providers (not required for local dev)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# --- Map provider (pluggable — see src/lib/map/provider.ts) ----------------
# Which provider adapter to use: "stylised" (no key, built-in) | "maptiler" | "mapbox" | "google"
NEXT_PUBLIC_MAP_PROVIDER="stylised"
NEXT_PUBLIC_MAPTILER_KEY=""
NEXT_PUBLIC_MAPBOX_TOKEN=""
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""
# Default map centre = Iloilo City
NEXT_PUBLIC_MAP_CENTER_LAT="10.7202"
NEXT_PUBLIC_MAP_CENTER_LNG="122.5621"

# --- Object storage (property photos, imported images) --------------------
# Adapter selected in src/lib/storage/provider.ts: "local" | "s3" | "supabase"
STORAGE_PROVIDER="local"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- Image processing (thumbnails, optimisation) --------------------------
# "sharp" (local) | external service URL. Thumbnails are generated on upload.
IMAGE_PROCESSOR="sharp"

# --- Email / notifications ------------------------------------------------
EMAIL_PROVIDER="console" # "console" (dev) | "resend" | "smtp"
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Real Estate Iloilo <no-reply@realestateiloilo.app>"

# --- Search (optional external index) -------------------------------------
# Local dev uses the SQL-backed search. For scale, wire an external engine.
SEARCH_PROVIDER="sql" # "sql" | "meilisearch" | "typesense" | "opensearch"
MEILISEARCH_HOST=""
MEILISEARCH_KEY=""

# --- Job queue (import pipeline / background jobs) ------------------------
# Local dev runs jobs inline/in-process. For production use a real queue.
QUEUE_DRIVER="inline" # "inline" | "redis" (BullMQ) | "sqs"
REDIS_URL=""

# --- External marketplace / feed integrations (Import Engine) -------------
# Each adapter is opt-in and only enabled when its source is AUTHORISED.
# NEVER use these to bypass a marketplace's terms, auth, or CAPTCHAs.
# Official/approved API credentials only:
META_MARKETPLACE_API_TOKEN=""       # only if an approved Meta feed/API is granted
META_MARKETPLACE_CATALOG_ID=""
# Generic partner/broker feed polling is configured per-source in the DB
# (import_sources), not here. This flag just gates automated scheduling:
IMPORTS_AUTOMATION_ENABLED="false"
IMPORT_URL_FETCH_TIMEOUT_MS="12000"
# Respect robots.txt + only fetch metadata the user is authorised to import:
IMPORT_RESPECT_ROBOTS="true"

# --- AI natural-language search (optional) --------------------------------
# The NL search parser falls back to a deterministic local parser when unset.
AI_PROVIDER="local" # "local" | "anthropic"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# --- Analytics (optional) -------------------------------------------------
ANALYTICS_PROVIDER="none"
