{
  "name": "realestate-iloilo",
  "version": "0.1.0",
  "private": true,
  "description": "Real Estate Iloilo — a modern real-estate marketplace focused on Iloilo, Philippines.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma db push --force-reset && tsx prisma/seed.ts",
    "setup": "prisma db push && tsx prisma/seed.ts",
    "cap:add:ios": "cap add ios",
    "cap:add:android": "cap add android",
    "cap:sync": "cap sync",
    "cap:ios": "cap open ios",
    "cap:android": "cap open android",
    "mobile:icons": "capacitor-assets generate --assetPath assets --iconBackgroundColor '#031A14' --iconBackgroundColorDark '#031A14' --splashBackgroundColor '#031A14' --splashBackgroundColorDark '#050706'",
    "cap:pro:add:ios": "CAP_FLAVOR=pro cap add ios",
    "cap:pro:add:android": "CAP_FLAVOR=pro cap add android",
    "cap:pro:sync": "CAP_FLAVOR=pro cap sync",
    "cap:pro:ios": "CAP_FLAVOR=pro cap open ios",
    "cap:pro:android": "CAP_FLAVOR=pro cap open android",
    "mobile:pro:assets": "node scripts/make-pro-assets.mjs",
    "mobile:pro:icons": "CAP_FLAVOR=pro capacitor-assets generate --assetPath assets-pro --iconBackgroundColor '#031A14' --iconBackgroundColorDark '#031A14' --splashBackgroundColor '#031A14' --splashBackgroundColorDark '#050706'"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@capacitor/app": "^6.0.3",
    "@capacitor/browser": "^6.0.6",
    "@capacitor/camera": "^6.1.3",
    "@capacitor/core": "^6.2.1",
    "@capacitor/geolocation": "^6.1.1",
    "@capacitor/keyboard": "^6.0.4",
    "@capacitor/preferences": "^6.0.4",
    "@capacitor/push-notifications": "^6.0.5",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^2.4.3",
    "jose": "^5.9.6",
    "lucide-react": "^0.454.0",
    "next": "14.2.18",
    "onesignal-cordova-plugin": "^5.5.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@capacitor/android": "^6.2.1",
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/ios": "^6.2.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.18",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
