// Real Estate Iloilo — data model
// Local dev: SQLite. Production: switch provider to "postgresql" (PostGIS
// recommended for geospatial listing search). Enum-like fields are stored as
// String on SQLite; the allowed values are enforced in the app layer via Zod
// (see src/lib/enums.ts) so the same schema runs on both databases.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Postgres for production (Vercel). For zero-setup local dev you can switch
  // this to "sqlite" and set DATABASE_URL="file:./dev.db" — the schema is
  // written to be portable across both (no provider-specific features).
  provider  = "postgresql"
  // Runtime uses the pooled connection (Supabase transaction pooler, port 6543).
  url       = env("DATABASE_URL")
  // Migrations / `prisma db push` use a direct connection (port 5432). Only the
  // Prisma CLI reads this; the app runtime never does. Set it to the direct
  // Supabase string (or the same value as DATABASE_URL if you only have one).
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Identity & roles
// ---------------------------------------------------------------------------

model User {
  id                 String   @id @default(cuid())
  name               String
  email              String   @unique
  phone              String?
  passwordHash       String?
  role               String   @default("BUYER") // VISITOR|BUYER|OWNER|AGENT|BROKER|DEVELOPER|ADMIN
  avatarUrl          String?
  verificationStatus String   @default("UNVERIFIED") // UNVERIFIED|PENDING|VERIFIED|REJECTED
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  agent            Agent?
  listingsAsOwner  Listing[]        @relation("OwnerListings")
  savedProperties  SavedProperty[]
  inquiries        Inquiry[]        @relation("InquiryFromUser")
  sentMessages     Message[]        @relation("MessageSender")
  threadsA         Thread[]         @relation("ThreadBuyer")
  reportsFiled     Report[]         @relation("ReportReporter")
  viewingRequests  ViewingRequest[] @relation("ViewingRequester")
  notifications    Notification[]
  auditLogs        AuditLog[]
  importJobs       ImportJob[]      @relation("ImportInitiator")

  developer        Developer?
  projectLeads     ProjectLead[]    @relation("LeadBuyer")
  reservations     UnitReservation[] @relation("ReservationBuyer")

  @@index([role])
}

model Agent {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company       String?
  licenseNumber String? // PRC license
  bio           String?
  verified      Boolean  @default(false)
  contactPhone  String?
  contactEmail  String?
  responseTime  String? // e.g. "about 2 hours"
  createdAt     DateTime @default(now())

  listings       Listing[]        @relation("AgentListings")
  reviews        AgentReview[]
  importSources  ImportSource[]
  threads        Thread[]         @relation("ThreadAgent")
  leads          Lead[]
  viewingSlots   ViewingRequest[] @relation("ViewingAgent")

  projectAccess  AgentProjectAccess[]
  projectLeads   ProjectLead[]
  reservations   UnitReservation[]
  sales          UnitSale[]
}

model AgentReview {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  authorName String
  rating    Int // 1..5
  text      String
  createdAt DateTime @default(now())

  @@index([agentId])
}

// ---------------------------------------------------------------------------
// Property & listing
// ---------------------------------------------------------------------------

model Property {
  id           String   @id @default(cuid())
  title        String
  description  String
  propertyType String // HOUSE|CONDO|APARTMENT|TOWNHOUSE|LOT|COMMERCIAL|OFFICE|WAREHOUSE|FARM|RESORT|INDUSTRIAL|BUILDING|OTHER
  address      String?
  barangay     String?
  city         String // Iloilo City, Pavia, Oton, ...
  province     String   @default("Iloilo")
  latitude     Float?
  longitude    Float?
  bedrooms     Int?
  bathrooms    Int?
  floorArea    Float? // sqm
  lotArea      Float? // sqm
  parking      Int?
  furnishing   String? // UNFURNISHED|SEMI_FURNISHED|FURNISHED
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  listing    Listing?
  amenities  PropertyAmenity[]

  @@index([city])
  @@index([propertyType])
  @@index([latitude, longitude])
}

model Amenity {
  id         String            @id @default(cuid())
  name       String            @unique
  properties PropertyAmenity[]
  projects   ProjectAmenity[]
}

model PropertyAmenity {
  propertyId String
  amenityId  String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity    Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
}

model Listing {
  id           String   @id @default(cuid())
  propertyId   String   @unique
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  agentId String?
  agent   Agent?  @relation("AgentListings", fields: [agentId], references: [id])
  ownerId String?
  owner   User?   @relation("OwnerListings", fields: [ownerId], references: [id])

  listingType String // SALE|RENT
  price       Float
  currency    String  @default("PHP")
  priceDropPct Int?   // set when a price drop is recorded

  // status lifecycle
  status             String @default("DRAFT") // DRAFT|PENDING_REVIEW|ACTIVE|RESERVED|SOLD|RENTED|EXPIRED|REJECTED|ARCHIVED
  verificationStatus String @default("UNVERIFIED") // UNVERIFIED|PENDING|VERIFIED|REJECTED
  verifiedNote       String? // e.g. "Broker-verified"

  // provenance / source attribution (imported listings)
  sourceId        String?
  source          ImportSource? @relation(fields: [sourceId], references: [id])
  sourceUrl       String?
  sourceListingId String?
  sourceName      String? // human label e.g. "Broker XML feed"
  importMethod    String? // API|FEED|CSV|JSON|XML|MANUAL_URL|NATIVE
  importJobId     String?
  importRecordId  String?       @unique

  // freshness tracking
  sourceLastSeenAt DateTime?
  lastVerifiedAt   DateTime?
  publishedAt      DateTime?
  expiresAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  images          ListingImage[]
  savedBy         SavedProperty[]
  inquiries       Inquiry[]
  reports         Report[]
  views           PropertyView[]
  threads         Thread[]
  viewingRequests ViewingRequest[]
  leads           Lead[]
  duplicatesA     DuplicateMatch[] @relation("DupA")
  duplicatesB     DuplicateMatch[] @relation("DupB")

  @@index([status])
  @@index([listingType])
  @@index([price])
  @@index([publishedAt])
  @@index([sourceId])
}

model ListingImage {
  id          String  @id @default(cuid())
  listingId   String
  listing     Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url         String
  thumbUrl    String?
  source      String? // ORIGINAL_UPLOAD|IMPORTED|EXTERNAL_REF
  rightsStatus String @default("OWNED") // OWNED|AUTHORISED|PENDING_PERMISSION|EXTERNAL_REF
  sortOrder   Int     @default(0)
  width       Int?
  height      Int?
  createdAt   DateTime @default(now())

  @@index([listingId])
}

// ---------------------------------------------------------------------------
// Engagement
// ---------------------------------------------------------------------------

model SavedProperty {
  id         String   @id @default(cuid())
  userId     String
  listingId  String
  collection String   @default("All") // buyer-defined collection
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, listingId])
  @@index([userId])
}

model Inquiry {
  id         String   @id @default(cuid())
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  fromUserId String?
  fromUser   User?    @relation("InquiryFromUser", fields: [fromUserId], references: [id])
  name       String
  email      String?
  phone      String?
  message    String
  channel    String   @default("MESSAGE") // MESSAGE|CALL|VIEWING|EMAIL
  status     String   @default("NEW") // NEW|CONTACTED|QUALIFIED|CLOSED
  createdAt  DateTime @default(now())

  lead Lead?

  @@index([listingId])
  @@index([status])
}

model Lead {
  id        String   @id @default(cuid())
  agentId   String
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id])
  inquiryId String?  @unique
  inquiry   Inquiry? @relation(fields: [inquiryId], references: [id])
  name      String
  contact   String?
  stage     String   @default("NEW") // NEW|CONTACTED|VIEWING|OFFER|WON|LOST
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agentId])
  @@index([stage])
}

model Thread {
  id        String   @id @default(cuid())
  listingId String?
  listing   Listing? @relation(fields: [listingId], references: [id])
  buyerId   String
  buyer     User     @relation("ThreadBuyer", fields: [buyerId], references: [id])
  agentId   String?
  agent     Agent?   @relation("ThreadAgent", fields: [agentId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages Message[]

  @@index([buyerId])
  @@index([agentId])
}

model Message {
  id        String   @id @default(cuid())
  threadId  String
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation("MessageSender", fields: [senderId], references: [id])
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([threadId])
}

model ViewingRequest {
  id          String   @id @default(cuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  requesterId String?
  requester   User?    @relation("ViewingRequester", fields: [requesterId], references: [id])
  agentId     String?
  agent       Agent?   @relation("ViewingAgent", fields: [agentId], references: [id])
  scheduledAt DateTime
  slotLabel   String?
  status      String   @default("REQUESTED") // REQUESTED|CONFIRMED|DECLINED|COMPLETED|CANCELLED
  note        String?
  createdAt   DateTime @default(now())

  @@index([listingId])
}

model PropertyView {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  viewerKey String? // hashed session/user key for de-duping
  source    String? // web|app|share
  createdAt DateTime @default(now())

  @@index([listingId])
  @@index([createdAt])
}

model Report {
  id         String   @id @default(cuid())
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reporterId String?
  reporter   User?    @relation("ReportReporter", fields: [reporterId], references: [id])
  reason     String // SCAM|DUPLICATE|WRONG_INFO|SOLD|OFFENSIVE|OTHER
  detail     String?
  status     String   @default("OPEN") // OPEN|REVIEWING|ACTIONED|DISMISSED
  createdAt  DateTime @default(now())

  @@index([status])
}

// ---------------------------------------------------------------------------
// Import engine
// ---------------------------------------------------------------------------

model ImportSource {
  id           String   @id @default(cuid())
  name         String
  adapter      String // META|BROKER_FEED|CSV|JSON|XML|MANUAL_URL
  config       String? // JSON blob: feed url, auth ref, mapping
  ownerAgentId String?
  ownerAgent   Agent?   @relation(fields: [ownerAgentId], references: [id])
  authorised   Boolean  @default(false) // legal/permission gate
  automated    Boolean  @default(false) // scheduled sync allowed
  schedule     String? // MANUAL|EVERY_15M|HOURLY|DAILY
  attribution  String? // required attribution text
  lastSyncAt   DateTime?
  nextSyncAt   DateTime?
  createdAt    DateTime @default(now())

  jobs     ImportJob[]
  records  ImportRecord[]
  listings Listing[]

  @@index([adapter])
}

model ImportJob {
  id             String   @id @default(cuid())
  sourceId       String
  source         ImportSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  initiatorId    String?
  initiator      User?    @relation("ImportInitiator", fields: [initiatorId], references: [id])
  status         String   @default("QUEUED") // QUEUED|RUNNING|COMPLETED|FAILED|PARTIAL
  trigger        String   @default("MANUAL") // MANUAL|SCHEDULED
  discovered     Int      @default(0)
  updated        Int      @default(0)
  skipped        Int      @default(0)
  duplicates     Int      @default(0)
  errors         Int      @default(0)
  log            String? // JSON array of stage log lines
  startedAt      DateTime?
  finishedAt     DateTime?
  createdAt      DateTime @default(now())

  records ImportRecord[]

  @@index([sourceId])
  @@index([status])
}

model ImportRecord {
  id            String   @id @default(cuid())
  jobId         String?
  job           ImportJob? @relation(fields: [jobId], references: [id])
  sourceId      String
  source        ImportSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  // raw + normalized payloads (JSON)
  raw           String
  normalized    String?
  sourceUrl     String?
  sourceListingId String?

  status        String   @default("PENDING") // PENDING|PROCESSING|NEEDS_REVIEW|DUPLICATE|APPROVED|REJECTED|PUBLISHED|ARCHIVED|SOURCE_UNAVAILABLE
  dupConfidence Int? // 0..100 best duplicate score
  dupListingId  String? // best-match existing listing
  rightsFlag    String   @default("UNKNOWN") // UNKNOWN|AUTHORISED|NEEDS_PERMISSION
  reviewerId    String?
  reviewNote    String?
  publishedListingId String? @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  matches DuplicateMatch[] @relation("MatchRecord")

  @@index([status])
  @@index([sourceId])
}

model DuplicateMatch {
  id           String   @id @default(cuid())
  recordId     String?
  record       ImportRecord? @relation("MatchRecord", fields: [recordId], references: [id], onDelete: Cascade)
  listingAId   String? // existing listing (candidate)
  listingA     Listing? @relation("DupA", fields: [listingAId], references: [id])
  listingBId   String? // other existing listing when comparing two natives
  listingB     Listing? @relation("DupB", fields: [listingBId], references: [id])
  confidence   Int // 0..100
  signals      String // JSON: per-signal contributions
  resolution   String   @default("PENDING") // PENDING|MERGED|SEPARATE|IGNORED
  createdAt    DateTime @default(now())

  @@index([confidence])
  @@index([resolution])
}

// ---------------------------------------------------------------------------
// Platform
// ---------------------------------------------------------------------------

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // INQUIRY|LISTING_APPROVED|LISTING_REJECTED|LISTING_EXPIRING|DUPLICATE_DETECTED|IMPORT_COMPLETED|IMPORT_FAILED|STATUS_CHANGED|VIEWING
  title     String
  body      String?
  href      String?
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([readAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  action    String
  entity    String
  entityId  String?
  meta      String? // JSON
  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([createdAt])
}

// ===========================================================================
// Developer ecosystem (brief §5–28) — Developer → Project → Building → Unit,
// agent distribution, leads, reservations (with server-side inventory locking).
// ===========================================================================

model Developer {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company            String
  description        String?
  website            String?
  logoUrl            String?
  registrationNo     String? // SEC / DTI registration (verification)
  repName            String? // authorized representative
  contactEmail       String?
  contactPhone       String?
  yearsOperating     Int?
  verified           Boolean  @default(false)
  verificationStatus String   @default("UNVERIFIED") // UNVERIFIED|PENDING|VERIFIED|SUSPENDED
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  projects  Project[]
  documents DeveloperDocument[]

  @@index([verificationStatus])
}

// Sensitive verification documents — never exposed publicly.
model DeveloperDocument {
  id          String   @id @default(cuid())
  developerId String
  developer   Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)
  type        String // SEC_REGISTRATION|DTI|LICENSE_TO_SELL|REP_ID|OTHER
  title       String
  url         String
  createdAt   DateTime @default(now())

  @@index([developerId])
}

model Project {
  id               String   @id @default(cuid())
  developerId      String
  developer        Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)
  name             String
  slug             String   @unique
  description      String?
  projectType      String // CONDO|SUBDIVISION|TOWNHOUSE|COMMERCIAL|MIXED_USE|OFFICE|OTHER
  address          String?
  barangay         String?
  city             String
  province         String   @default("Iloilo")
  latitude         Float?
  longitude        Float?
  completionDate   DateTime?
  turnoverDate     DateTime?
  website          String?
  brochureUrl      String?
  paymentTerms     String?
  financingOptions String?
  status           String   @default("SELLING") // PRE_LAUNCH|SELLING|CONSTRUCTION|NEAR_COMPLETION|COMPLETED|SOLD_OUT|ARCHIVED
  visibility       String   @default("PUBLIC") // PUBLIC|AGENTS_ONLY|PRIVATE
  distribution     String   @default("ALL_AGENTS") // ALL_AGENTS|SELECTED_AGENCIES|SELECTED_AGENTS|INVITE_ONLY
  leadOwnership    String   @default("SHARED") // DEVELOPER|AGENT|SHARED (brief §18)
  defaultCommission Float?  // default agent commission % for this project
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  buildings    Building[]
  units        Unit[]
  images       ProjectImage[]
  amenities    ProjectAmenity[]
  documents    ProjectDocument[]
  agentAccess  AgentProjectAccess[]
  leads        ProjectLead[]
  reservations UnitReservation[]
  sales        UnitSale[]
  views        ProjectView[]

  @@index([status])
  @@index([visibility])
  @@index([city])
  @@index([developerId])
}

model ProjectImage {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int     @default(0)

  @@index([projectId])
}

model ProjectAmenity {
  projectId String
  amenityId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  amenity   Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([projectId, amenityId])
}

// Marketing materials (brief §22). visibility PUBLIC|AGENT_ONLY.
model ProjectDocument {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title      String
  type       String // BROCHURE|FLOOR_PLAN|PRICE_LIST|VIDEO|PHOTO|LOGO|SALES_KIT|PRESENTATION|OTHER
  url        String
  visibility String   @default("PUBLIC") // PUBLIC|AGENT_ONLY
  createdAt  DateTime @default(now())

  @@index([projectId])
}

model Building {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name      String
  floors    Int?
  createdAt DateTime @default(now())

  units Unit[]

  @@index([projectId])
}

model Unit {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  buildingId     String?
  building       Building? @relation(fields: [buildingId], references: [id])
  unitNumber     String
  floor          Int?
  unitType       String // STUDIO|1BR|2BR|3BR|LOFT|PENTHOUSE|TOWNHOUSE|LOT|COMMERCIAL|OTHER
  bedrooms       Int?
  bathrooms      Int?
  floorArea      Float? // sqm
  balconyArea    Float?
  parking        Int?
  price          Float
  agentPrice     Float? // agent-only price (never exposed publicly)
  reservationFee Float?
  paymentTerms   String?
  status         String   @default("AVAILABLE") // AVAILABLE|RESERVED|SOLD|ON_HOLD|UNAVAILABLE|UNDER_CONTRACT
  visibility     String   @default("PUBLIC") // PUBLIC|AGENTS_ONLY|PRIVATE
  orientation    String?
  view           String?
  floorPlanUrl   String?
  images         String? // JSON array of urls
  features       String? // JSON array
  // server-side inventory locking (brief §21)
  holdAgentId    String?
  holdExpiresAt  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  reservations UnitReservation[]
  sale         UnitSale?
  leads        ProjectLead[]

  @@unique([projectId, unitNumber])
  @@index([projectId])
  @@index([status])
  @@index([unitType])
}

// Developer authorises an agent to distribute a project's inventory (brief §13–15).
model AgentProjectAccess {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentId       String
  agent         Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  status        String   @default("REQUESTED") // REQUESTED|APPROVED|REJECTED|REVOKED
  commissionPct Float?
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([projectId, agentId])
  @@index([status])
}

// Developer/agent lead (brief §18, §19). ownership DEVELOPER|AGENT|SHARED.
model ProjectLead {
  id            String   @id @default(cuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  unitId        String?
  unit          Unit?    @relation(fields: [unitId], references: [id])
  agentId       String?
  agent         Agent?   @relation(fields: [agentId], references: [id])
  buyerUserId   String?
  buyer         User?    @relation("LeadBuyer", fields: [buyerUserId], references: [id])
  name          String
  contact       String?
  email         String?
  budget        String?
  unitTypeInterest String?
  source        String   @default("PUBLIC") // PUBLIC|AGENT|IMPORT
  ownership     String   @default("DEVELOPER") // DEVELOPER|AGENT|SHARED
  status        String   @default("NEW") // NEW|CONTACTED|VIEWING|RESERVED|WON|LOST
  createdAt     DateTime @default(now())

  @@index([projectId])
  @@index([agentId])
  @@index([status])
}

model UnitReservation {
  id            String   @id @default(cuid())
  unitId        String
  unit          Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentId       String?
  agent         Agent?   @relation(fields: [agentId], references: [id])
  buyerUserId   String?
  buyer         User?    @relation("ReservationBuyer", fields: [buyerUserId], references: [id])
  buyerName     String
  buyerContact  String?
  status        String   @default("REQUESTED") // REQUESTED|HELD|RESERVED|APPROVED|REJECTED|CANCELLED|EXPIRED|SOLD
  holdExpiresAt DateTime?
  note          String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([unitId])
  @@index([projectId])
  @@index([status])
}

model UnitSale {
  id          String   @id @default(cuid())
  unitId      String   @unique
  unit        Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agentId     String?
  agent       Agent?   @relation(fields: [agentId], references: [id])
  buyerName   String
  price       Float
  commissionPct Float?
  soldAt      DateTime @default(now())

  @@index([projectId])
  @@index([agentId])
}

model ProjectView {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  unitId    String?
  source    String? // web|app|share
  createdAt DateTime @default(now())

  @@index([projectId])
  @@index([createdAt])
}
